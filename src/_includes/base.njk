<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set defaultDescription = "Real-time individualization at scale. NEXTGRES connects to your existing data, infers what each customer wants right now, and acts on it instantly. No data migration. No ML team." %}
  <title>{% if title == 'Home' %}NEXTGRES — Real-Time Individualization at Scale{% elif title %}{{ title }} | NEXTGRES{% else %}NEXTGRES{% endif %}</title>
  <meta name="description" content="{{ description or defaultDescription }}">
  <link rel="canonical" href="https://nextgres.ai{{ page.url }}">
  <meta property="og:title" content="{{ ogTitle or title or 'NEXTGRES' }}">
  <meta property="og:description" content="{{ description or defaultDescription }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="https://nextgres.ai{{ page.url }}">
  <meta property="og:site_name" content="NEXTGRES">
  <meta property="og:image" content="https://nextgres.ai{{ ogImage or '/assets/og-default.png' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title or 'NEXTGRES' }}">
  <meta name="twitter:description" content="{{ description or defaultDescription }}">
  <meta name="twitter:image" content="https://nextgres.ai{{ ogImage or '/assets/og-default.png' }}">

  <link href="/css/styles.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">
  {# Google Analytics 4 (GA4) #}
  {% if ga4_id and ga4_id != 'G-XXXXXXXXXX' %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}  
    gtag('js', new Date());
    gtag('config', '{{ ga4_id }}', {'debug_mode': true});
  </script>
  {% endif %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "NEXTGRES",
      "url": "https://nextgres.ai",
      "description": "NEXTGRES brings your user profiles and events together—so you can ship smarter features, faster.",
      "sameAs": [
        "https://www.linkedin.com/company/nextgres/"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@nextgres.com",
        "contactType": "Customer Support"
      }
    }
  </script>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand text-light" href="/">NEXTGRES</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link text-light" href="/">Home</a></li>
          <!-- add other global links here -->
          <li class="nav-item"><a class="nav-link text-light" href="/about">About</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container d-flex flex-column align-items-center justify-content-center min-vh-75">
    {% if page.markdown %}
      {{ content | markdown | safe }}
    {% else %}
      {{ content | safe }}
    {% endif %}
  </main>
  <footer class="footer-section py-4 bg-dark text-light w-100 position-relative" style="left:0;right:0;margin-left:auto;margin-right:auto;">
  <div class="container">
    <div class="row">
      <div class="col-12 col-md-4 mb-3 mb-md-0">
        <h6 class="fw-bold mb-2">NEXTGRES</h6>
        <a href="/about" class="text-light d-block mb-1">About</a>
        <a href="/get-started" class="text-light d-block mb-1">Contact Us</a>
        <a href="https://www.linkedin.com/company/nextgres" class="text-light d-block mb-1">LinkedIn</a>
        {# <a href="/privacy" class="text-light d-block mb-1">Privacy Policy</a> #}
        {# <a href="/terms" class="text-light d-block mb-1">Terms of Service</a> #}
      </div>
      <div class="col-12 col-md-4 mb-3 mb-md-0">
        <h6 class="fw-bold mb-2">NEXTGRES for Your Industry</h6>
        <a href="/saas-solutions" class="text-light d-block mb-1">SaaS Solutions</a>
        <a href="/ecommerce-growth" class="text-light d-block mb-1">E-commerce Growth</a>
        <a href="/financial-services" class="text-light d-block mb-1">Financial Services</a>
        <a href="/health-wellness" class="text-light d-block mb-1">Health &amp; Wellness</a>
        <a href="/media-entertainment" class="text-light d-block mb-1">Media &amp; Entertainment</a>
      </div>
      <div class="col-12 col-md-4 mb-3 mb-md-0">
        <h6 class="fw-bold mb-2">Customer Support</h6>
        <a href="/customer-support" class="text-light d-block mb-1">Support</a>
      </div>
    </div>
  </div>
</footer>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Track entry into the root funnel
      if (window.location.pathname === '/') {
        gtag('event', 'funnel_entry_root', {
          'event_category': 'funnel',
          'event_label': 'Root Funnel Entry',
          'page_path': window.location.pathname
        });
      }

      // Dynamically track navigation to industry pages using Eleventy collections
      const industryPages = {{ collections.industries | jsonify }};

      industryPages.forEach(function(page) {
        document.querySelectorAll(`a[href*="${page.url}"]`).forEach(function(link) {
          link.addEventListener('click', function() {
            gtag('event', 'funnel_navigate_to_industry', {
              'event_category': 'funnel',
              'event_label': 'Navigate to Industry',
              'page_path': link.getAttribute('href')
            });
          });
        });

        // Track entry from industry landing pages
        if (window.location.pathname.includes(page.url)) {
          gtag('event', 'funnel_entry_from_industry', {
            'event_category': 'funnel',
            'event_label': 'Entry from Industry Page',
            'page_path': window.location.pathname
          });
        }
      });

      // Track form submission on "Start Personalizing Now" page
      if (window.location.pathname === '/get-started') {
        var form = document.querySelector('form[name="beta"]');
        if (form) {
          form.addEventListener('submit', function() {
            gtag('event', 'funnel_form_submission', {
              'event_category': 'funnel',
              'event_label': 'Beta Form Submission',
              'page_path': window.location.pathname
            });
          });
        }
      }

      // Track "Start Personalizing Now" clicks
      document.querySelectorAll('a[aria-label="Start Personalizing Now"], a.btn-primary[href="/get-started"]')
        .forEach(function(btn) {
          btn.addEventListener('click', function() {
            if (typeof gtag === 'function') {
              gtag('event', 'get_started_click', {
                'event_category': 'engagement',
                'event_label': window.location.pathname
              });
            }
          });
        });

      // Track beta form submissions
      var form = document.querySelector('form[name="beta"]');
      if (form) {
        form.addEventListener('submit', function() {
          if (typeof gtag === 'function') {
            gtag('event', 'beta_form_submit', {
              'event_category': 'engagement',
              'event_label': window.location.pathname
            });
          }
        });
      }
    });
  </script>
</body>
</html>
