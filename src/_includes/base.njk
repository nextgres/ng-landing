<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | NEXTGRES{% else %}NEXTGRES{% endif %}</title>
  <meta name="description" content="NEXTGRES is the Product Decision Platform that turns behavioral signals into real-time product decisions — recommendations, search ranking, and personalization.">
  <meta property="og:title" content="{{ ogTitle or 'NEXTGRES — Product Decision Platform' }}">
  <meta property="og:description" content="NEXTGRES converges behavioral signals from analytics, product, and marketing systems so product and growth teams can deliver recommendations, search ranking, and personalization in real time.">
  <meta property="og:type" content="{{ ogType or 'website' }}">

  <link href="/css/styles.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- AOS Scroll Animations -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css">
  {# Google Analytics 4 (GA4) #}
  {% if ga4_id and ga4_id != 'G-XXXXXXXXXX' %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga4_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}  
    gtag('js', new Date());
    gtag('config', '{{ ga4_id }}', {'debug_mode': true});
  </script>
  {% endif %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "NEXTGRES",
      "url": "https://nextgres.ai",
      "description": "NEXTGRES is the Product Decision Platform that turns behavioral signals into real-time product decisions.",
      "sameAs": [
        "https://www.linkedin.com/company/nextgres/"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "info@nextgres.com",
        "contactType": "Customer Support"
      }
    }
  </script>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand text-light" href="/">NEXTGRES</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link text-light" href="/">Home</a></li>
          <!-- add other global links here -->
          <li class="nav-item"><a class="nav-link text-light" href="/about">About</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="container d-flex flex-column align-items-center justify-content-center min-vh-75">
    {% if page.markdown %}
      {{ content | markdown | safe }}
    {% else %}
      {{ content | safe }}
    {% endif %}
  </main>
  <footer class="footer-section py-4 bg-dark text-light text-center w-100 position-relative" style="left:0;right:0;margin-left:auto;margin-right:auto;">
  <div class="container-fluid p-0">
    <a href="/about" class="text-light">About NEXTGRES</a> |
    {# <a href="/privacy" class="text-light">Privacy Policy</a> |
    <a href="/terms" class="text-light">Terms of Service</a> | #}
    <a href="/get-started" class="text-light">Contact Us</a> |
    <a href="https://www.linkedin.com/company/nextgres" class="text-light">LinkedIn</a> |
  </div>
</footer>
  <!-- AOS Library -->
  <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize AOS scroll animations
      AOS.init({
        duration: 700,
        once: true,
        offset: 80,
        easing: 'ease-out-cubic'
      });

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
        anchor.addEventListener('click', function(e) {
          e.preventDefault();
          var target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // GA4 Tracking
      if (typeof gtag === 'function') {
        // Track page entry
        if (window.location.pathname === '/') {
          gtag('event', 'funnel_entry_root', {
            'event_category': 'funnel',
            'event_label': 'Root Funnel Entry',
            'page_path': window.location.pathname
          });
        }

        // Track demo request clicks
        document.querySelectorAll('a[aria-label="Request Demo"], a.btn-primary[href="/get-started"]')
          .forEach(function(btn) {
            btn.addEventListener('click', function() {
              gtag('event', 'request_demo_click', {
                'event_category': 'engagement',
                'event_label': window.location.pathname
              });
            });
          });

        // Track "See Architecture" clicks
        document.querySelectorAll('a[href="#architecture"]')
          .forEach(function(btn) {
            btn.addEventListener('click', function() {
              gtag('event', 'see_architecture_click', {
                'event_category': 'engagement',
                'event_label': window.location.pathname
              });
            });
          });

        // Track form submissions
        var form = document.querySelector('form[name="beta"]');
        if (form) {
          form.addEventListener('submit', function() {
            gtag('event', 'demo_form_submit', {
              'event_category': 'engagement',
              'event_label': window.location.pathname
            });
          });
        }

        // Track industry page navigation (for industry pages)
        {% if collections.industries %}
        var industryPages = {{ collections.industries | jsonify }};
        industryPages.forEach(function(page) {
          document.querySelectorAll('a[href*="' + page.url + '"]').forEach(function(link) {
            link.addEventListener('click', function() {
              gtag('event', 'funnel_navigate_to_industry', {
                'event_category': 'funnel',
                'event_label': 'Navigate to Industry',
                'page_path': link.getAttribute('href')
              });
            });
          });

          if (window.location.pathname.includes(page.url)) {
            gtag('event', 'funnel_entry_from_industry', {
              'event_category': 'funnel',
              'event_label': 'Entry from Industry Page',
              'page_path': window.location.pathname
            });
          }
        });
        {% endif %}
      }
    });
  </script>
</body>
</html>
