{% capture card_classes %}
card 
{% if type %}card-{{ type }} {% endif %}
{% if style %}card-{{ style }} {% endif %}
{% if thumbnail %}card-has-thumbnail {% endif %}
{% if icon or fa_icon %}card-has-icon {% endif %}
{% endcapture %}

<div class="{{ card_classes | strip | strip_newlines }}">
  {% if thumbnail %}
    <div class="card-thumbnail {% if thumbnail_size %}card-thumbnail-{{ thumbnail_size }}{% endif %}">
      {% if url %}
      <a href="{{ url | url }}">
        <img alt="{{ title }}" width="640" height="360" src="{{ thumbnail | url }}"/>
      </a>
    {% else %} 
      <img alt="{{ title }}" width="640" height="360" src="{{ thumbnail | url }}"/>
    {% endif %}
    </div>
  {% endif %}

  <div class="card-content">

    {% if icon %}
      <div class="card-icon">
        <img alt="{{ title }}" width="50" height="50" src=" {{ icon | url }} "/>
      </div>
    {% elsif fa_icon %}
      <div class=" card-icon">
        <i class="{{fa_icon}}"></i>
      </div>
    {% endif %}

    {% if authors or date %}
      <div class="card-meta">

        {% if authors %}
          <div class="card-authors">
            {% for author in authors %}
              {% include "framework/author", 
                author:author 
                style:'inline' 
              %}
            {% endfor %}
          </div>
        {% endif %}

        {% if date %}
          <div class="card-date">
            <span class="post-date-date">{{ date | date_to_long_string }}</span>
          </div>
        {% endif %}

      </div>
    {% endif %}

    <div class="card-title">
      <h3>
        <a href="{{ url | url }}">{{ title }}</a>
      </h3>
    </div>

    {% if client %}
      <div class="card-client">
        {{ client }}
      </div>
    {% endif %}

    {% if description %}
      <div class="card-description">
        <p>{{ description }}</p>
      </div>
    {% endif %}

    {% if categories %}
      <div class="card-categories mt-auto">
        {% for category in categories %}
          <a class="card-category" href="{{ "/category/" | url }}{{ category | slugify }}">{{ category }}</a>
        {% endfor %}
      </div>
    {% endif %}

    {% if url and show_read_more %}
      <div class="card-readmore">
        <a href="{{ url | url }}">Read More<i class="fas fa-long-arrow-alt-right"></i>
        </a>
      </div>
    {% endif %}

  </div>
</div>