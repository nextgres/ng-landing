{% assign style = style | default: "column" %}

<div class="card card-post card-{{ style }} {% if thumbnail %}card-has-thumbnail{% endif %} {% if icon or fa_icon %}card-has-icon{% endif %}">

  {% if thumbnail %}
    <div class="card-thumbnail {% if thumbnail_size %}card-thumbnail-{{ thumbnail_size }}{% endif %}">
      {% if url %}
      <a href="{{ url | url }}">
        <img alt="{{ title }}" width="640" height="360" src="{{ thumbnail | url }}"/>
      </a>
    {% else %} 
      <img alt="{{ title }}" width="640" height="360" src="{{ thumbnail | url }}"/>
    {% endif %}
    </div>
  {% endif %}

  <div class="card-content">
    {% if date or authors %}
    <div class="card-meta">

      {% if date %}
        <div class="card-date">{{ date | date_to_long_string }}</div>
      {% elsif authors %}
        <div class="card-authors">
          {% for author in authors limit: 1 %}
          {% assign author_id = author | replace: " ", "_" | downcase %}
          {% assign author_object = site.data.authors[author_id] %}
          {% include "framework/author", 
            name:author_object.name 
            image:author_object.image 
            date:author_object.date
          %}
          {% endfor %}
        </div>
      {% endif %}

    </div>  
    {% endif %}

    <div class="card-title">
      {% if url %}
        <h3><a href="{{ url | url }}">{{ title }}</a></h3>
      {% else %} 
        <h3>{{ title }}</h3>
      {% endif %}
    </div>

    {% if client %}
      <div class="card-client">
        {{ client }}
      </div>
    {% endif %}

    {% if description %}
      <div class="card-description">
        <p>{{ description }}</p>
      </div>
    {% endif %}

    {% if categories %}
      <div class="card-categories mt-auto">
        {% for category in categories %}
          <div class="card-category">
            {% include "framework/category-link", category_name:category show_count:false %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if url and show_read_more %}
      <div class="card-readmore">
        <a href="{{ url | url }}">Read More<i class="fas fa-long-arrow-alt-right"></i>
        </a>
      </div>
    {% endif %}

  </div>
</div>