<div class="contact">
  <form action="/contact/success" data-netlify="true" netlify-honeypot="bot-field" method="POST" name="{{ site.contact_form.netlify_form_name }}">
  <input type="hidden" name="form-name" value="{{ site.contact_form.netlify_form_name }}">
  <p class="d-none"><label>Don't fill this out: <input name="bot-field"></label></p>

  <div class="row">
    <div class="col-12 col-md-6">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" placeholder="Your name" required>
      </div>
    </div>
    <div class="col-12 col-md-6">
      <div class="form-group">
        <label for="email">Work Email</label>
        <input type="email" id="email" name="email" placeholder="you@company.com" required>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-12 col-md-6">
      <div class="form-group">
        <label for="company">Company</label>
        <input type="text" id="company" name="company" placeholder="Your company">
      </div>
    </div>
    <div class="col-12 col-md-6">
      <div class="form-group">
        <label for="role">Role</label>
        <input type="text" id="role" name="role" placeholder="e.g. VP Growth, Head of Product">
      </div>
    </div>
  </div>

  <div class="form-group">
    <label for="goals">What personalization challenge are you trying to solve?</label>
    <textarea id="goals" name="goals" rows="4" placeholder="Tell us about your use case — it helps us tailor the conversation."></textarea>
  </div>

  <input class="button button-primary" type="submit" value="Apply for Early Access">
  <p class="form-note mt-3">We'll reach out within one business day.</p>

  </form>
</div>
