{% assign heading = heading | default: hero.heading %}
{% assign sub_heading = sub_heading | default: hero.sub_heading %}
{% assign text_color = text_color | default: hero.text_color %}
{% assign divider = divider | default: hero.divider %}
{% assign background_image = background_image | default: hero.background_image %}
{% assign background_image_blend_mode = background_image_blend_mode | default: hero.background_image_blend_mode %}
{% assign background_color = background_color | default: hero.background_color %}
{% assign background_gradient = background_gradient | default: hero.background_gradient %}
{% assign fullscreen_desktop = fullscreen_desktop | default: hero.fullscreen_desktop %}
{% assign fullscreen_mobile = fullscreen_mobile | default: hero.fullscreen_mobile %}
{% assign buttons = buttons | default: hero.buttons %}
{% assign height = height | default: hero.height %}

{% capture bg_image %}
  {% if background_image and background_image != "" %}background-image: url('{{ background_image | url }}');{% endif %}
  {% if background_image_blend_mode and background_image != "" %}mix-blend-mode: {{ background_image_blend_mode }};{% endif %}
{% endcapture %}

{% capture bg_color %}
  {% if background_color and background_color != "" %}background-color: {{ background_color }};{% endif %}
{% endcapture %}

{% capture gradient %}
  {% if background_gradient %}hero-gradient{% endif %}
{% endcapture %}

{% capture fullscreen %}
  {% if fullscreen_desktop %}hero-fullscreen-desktop{% endif %}
  {% if fullscreen_mobile %}hero-fullscreen-mobile{% endif %}
{% endcapture %}

{% capture bg_height %}
  {% if height %}height: {{ height }};{% endif %}
{% endcapture %}

<div class="hero {{ fullscreen }} {{ gradient }}" style="{{ bg_color }} {{ bg_height }}">
  <div class="hero-background-image" style="{{ bg_image }}"></div>
  {% if divider %}{% include "framework/divider" %}{% endif %}
  <div class="container {% if divider %}pb-10{% endif %}">
    <div class="row align-items-center">
      <div class="col-12 {% if image %}col-lg-6{% endif %}">
        <div class="hero-text" style="{% if text_color %}color: {{ text_color }};{% endif %}">
          {% if heading %}<h1>{{ heading }}</h1>{% endif %}
          {% if sub_heading %}{{ sub_heading | markdownify }}{% endif %}
          {% if buttons.enabled and buttons.list.size > 0 %}
            <div class="hero-buttons">
              {% for button in buttons.list %}
                {% include "framework/button", 
                  text:button.text
                  url:button.url
                  external:button.external
                  size:button.size
                  outline:button.outline
                  style:button.style
                  fa_icon:button.fa_icon
                %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      {% if image %}
        <div class="col-12 col-lg-6">
          <div class="hero-image">
            <img src="{{ image | url }}"/>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>