<div class="author">
  {% if image %}
  <div class="author-image">
    <img src="{{ image }}" alt="{{ name }}" />
  </div>
  {% endif %}
  {% if name or date %}
  <div class="author-content">
    {% if name %}
      <div class="author-name">{{ name }}</div>
    {% endif %}

    {% if job %}
      <div class="author-job">{{ job }}</div>
    {% elsif date %}
      <div class="author-date">{{ date | date_to_long_string }}</div>
    {% endif %}
  </div>
  {% endif %}
</div>